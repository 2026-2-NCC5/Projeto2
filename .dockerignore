# flyctl launch added from .gitignore
# ── Python & Virtualenv ────────────────────────────────────────────────────────
**/__pycache__
**/*.py[cod]
**/*$py.class
**/*.so
**/.Python
**/build
**/develop-eggs
**/dist
**/downloads
**/eggs
**/.eggs
**/parts
**/sdist
**/var
**/wheels
**/share/python-wheels
**/*.egg-info
**/.installed.cfg
**/*.egg
**/MANIFEST

# Ambientes virtuais
**/.venv
**/venv
**/env
**/ENV
**/env.bak
**/venv.bak

# Testes e cobertura
**/.pytest_cache
**/.coverage
**/.coverage.*
**/nosetests.xml
**/coverage.xml
**/*.cover
**/*.py,cover
**/htmlcov
**/.mypy_cache

# Banco de dados local SQLite
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-journal

# ── Flutter & Dart ────────────────────────────────────────────────────────────
**/.dart_tool
**/.packages
**/*.dill
**/*.incremental.dill

# Saída de compilação Flutter
**/build
**/ephemeral
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Android específico
**/android/.gradle
**/android/local.properties
**/android/app/debug
**/android/app/profile
**/android/app/release
**/android/key.properties
**/*.keystore
**/*.jks

# iOS específico
**/ios/Pods
**/ios/.symlinks
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json

# Windows nativo Flutter
**/windows/flutter/ephemeral
**/windows/flutter/generated_plugins.cmake

# Linux / macOS nativo
**/linux/flutter/ephemeral
**/macos/Flutter/ephemeral

# ── Variáveis de Ambiente e Segredos ──────────────────────────────────────────
**/.env
**/.env.*
!**/.env.example

# ── Logs & Runtime ────────────────────────────────────────────────────────────
**/logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pids
**/*.pid
**/*.seed

# ── IDE & Sistema Operacional ─────────────────────────────────────────────────
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/*.swp
**/*.swo
**/*~

# VS Code (ignora cache/temp, preserva settings recomendadas se houver)
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json

# JetBrains / IntelliJ
**/.idea
**/*.iml
**/*.iws

**/*.apk
!**/ASA-Connect-Plus.apk


# flyctl launch added from src/mobile/android/.gitignore
src/mobile/android/**/gradle-wrapper.jar
src/mobile/android/.gradle
src/mobile/android/captures
src/mobile/android/gradlew
src/mobile/android/gradlew.bat
src/mobile/android/local.properties
src/mobile/android/**/GeneratedPluginRegistrant.java
src/mobile/android/**/.cxx

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
src/mobile/android/**/key.properties
src/mobile/android/**/**/*.keystore
src/mobile/android/**/**/*.jks

# flyctl launch added from src/mobile/ios/.gitignore
src/mobile/ios/**/**/dgph
src/mobile/ios/**/*.mode1v3
src/mobile/ios/**/*.mode2v3
src/mobile/ios/**/*.moved-aside
src/mobile/ios/**/*.pbxuser
src/mobile/ios/**/*.perspectivev3
src/mobile/ios/**/**/*sync
src/mobile/ios/**/.sconsign.dblite
src/mobile/ios/**/.tags*
src/mobile/ios/**/**/.vagrant
src/mobile/ios/**/**/DerivedData
src/mobile/ios/**/Icon?
src/mobile/ios/**/**/Pods
src/mobile/ios/**/**/.symlinks
src/mobile/ios/**/profile
src/mobile/ios/**/xcuserdata
src/mobile/ios/**/**/.generated
src/mobile/ios/**/Flutter/App.framework
src/mobile/ios/**/Flutter/Flutter.framework
src/mobile/ios/**/Flutter/Flutter.podspec
src/mobile/ios/**/Flutter/Generated.xcconfig
src/mobile/ios/**/Flutter/ephemeral
src/mobile/ios/**/Flutter/app.flx
src/mobile/ios/**/Flutter/app.zip
src/mobile/ios/**/Flutter/flutter_assets
src/mobile/ios/**/Flutter/flutter_export_environment.sh
src/mobile/ios/**/ServiceDefinitions.json
src/mobile/ios/**/Runner/GeneratedPluginRegistrant.*

# Exceptions to above rules.
!src/mobile/ios/**/default.mode1v3
!src/mobile/ios/**/default.mode2v3
!src/mobile/ios/**/default.pbxuser
!src/mobile/ios/**/default.perspectivev3

# flyctl launch added from src/mobile/windows/.gitignore
src/mobile/windows/**/flutter/ephemeral

# Visual Studio user-specific files.
src/mobile/windows/**/*.suo
src/mobile/windows/**/*.user
src/mobile/windows/**/*.userosscache
src/mobile/windows/**/*.sln.docstates

# Visual Studio build-related files.
src/mobile/windows/**/x64
src/mobile/windows/**/x86

# Visual Studio cache files
# files ending in .cache can be ignored
src/mobile/windows/**/*.[Cc]ache
# but keep track of directories ending in .cache
!src/mobile/windows/**/*.[Cc]ache

