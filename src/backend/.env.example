# Configurações do Banco de Dados (SQLite por padrão para dev local rápido, PostgreSQL para Docker)
DATABASE_URL=sqlite:///./asaconnect.db
# Para PostgreSQL descomente:
# DATABASE_URL=postgresql://asaconnect:asaconnect_secret_2025@localhost:5432/asaconnect_db

# Configurações de Segurança e JWT
JWT_SECRET_KEY=fecap_asa_connect_secret_key_jwt_2025_prod_super_secure_key_alvarista
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configurações do Agente RAG (RF04)
RAG_CONFIDENCE_THRESHOLD=0.60
RAG_MAX_CHUNKS=3
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
KNOWLEDGE_BASE_DIR=../knowledge_base

# Ambiente e Logs (Observabilidade)
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=ASA Connect API
API_V1_PREFIX=/api/v1
